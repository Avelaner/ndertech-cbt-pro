# Ndertech CBT Pro Backend Environment Configuration
PORT=8080
APP_ENV=development

# Database Configuration (PostgreSQL / MySQL)
DB_DRIVER=postgres
DATABASE_URL=host=localhost user=postgres password=postgres dbname=cbt_saas port=5432 sslmode=disable

# JWT Secret Key for token authentication
JWTSecret=ndertech-cbt-pro-super-secret-jwt-key
